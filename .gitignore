# Python
__pycache__/
*.py[cod]
*.pyo
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.*
*.pem
*.key

# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# OpenWebText pipeline data - synced to S3 instead (see configs/owt.yaml /
# the AWS working routine). Token ids are small and could go in git, but
# keep the whole directory out so nobody accidentally commits a large
# activation cache - recompute from data/owt/tokens/ instead of saving
# activations.
data/owt/

# Model files / checkpoints
*.pt
*.pth
*.ckpt
*.safetensors

# Python build / packaging
build/
dist/
*.egg-info/

# Testing / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

# Logs
*.log

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# OS files
.DS_Store
Thumbs.db

# VS Code local settings
.vscode/

# Temporary files
tempCodeRunnerFile.py