  "conditions": ["original", "original_repeat", "sae_splice", "norm_matched_random_error", "mean_ablation", "identity"],
  "seeds": {
    "sampling": 42,
    "random_error": "1000 + layer",
    "bootstrap": 0
  },
  "bootstrap": {
    "unit": "document",
    "n_resamples": 1000,
    "interval": "percentile 95%",
    "sensitivity_interval": "percentile 98.33% (Bonferroni over 3 layers) for H-G1"
  },
  "low_n_source_threshold_docs": 20,
  "hypothesis_H_G1": {
    "statement": "SAE-splice delta CE exceeds norm-matched-random delta CE at layer L",
    "statistic": "mean over documents of (doc-mean deltaCE_SAE - doc-mean deltaCE_random)",
    "supported_if": "95% CI lower bound > 0",
    "contradicted_if": "95% CI upper bound < 0",
    "otherwise": "inconclusive",
    "per_layer": true
  },
  "validity_gates": {
    "V1_sample_integrity": "file sha256 matches; 512 + 64 docs; eval and reference disjoint; manifest hash recorded",
    "V2_hook_equivalence": "hook activation equals output_hidden_states[L+1] exactly",
    "V3_determinism_identity_max_mean_kl_nats": 1e-6,
    "V4_sae_sanity": "measured L0 within factor 2 of release average_l0 and EV > 0 (smoke run)",
    "V5_no_substitution": "stop and ask if any pinned SAE id fails to load"
  }
